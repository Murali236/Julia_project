# Julia server reads environment variables; copy/export desired values in your shell.
HOST=127.0.0.1
PORT=8080
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ANALYSIS_TIMEOUT_SECONDS=45
REPORT_TIMEOUT_SECONDS=45
MAX_BODY_BYTES=262144
MAX_CONCURRENT_JOBS=2
# Optional: otherwise use system Chrome (macOS) or Playwright-installed Chromium.
# CHROMIUM_PATH=/usr/bin/chromium
# Frontend build-time override; otherwise /api uses the development/nginx proxy.
# VITE_API_URL=https://your-julia-api.example.com
