FROM julia:1.11-bookworm AS julia
FROM node:22-bookworm-slim
COPY --from=julia /usr/local/julia /usr/local/julia
ENV PATH="/usr/local/julia/bin:${PATH}" HOST=0.0.0.0 PORT=8080 CHROMIUM_NO_SANDBOX=1
WORKDIR /app
COPY package.json package-lock.json ./
COPY frontend/package.json frontend/package.json
RUN npm ci --omit=optional && npx playwright install --with-deps chromium
# Resolve stdlib metadata for the container's Julia version; the local Manifest
# was generated by Julia 1.13 and is not portable back to every 1.11 runtime.
COPY backend/Project.toml backend/
RUN julia --project=backend -e 'using Pkg; Pkg.instantiate(); Pkg.precompile()'
COPY backend/src backend/src
COPY reports reports
EXPOSE 8080
CMD ["julia", "--project=backend", "backend/src/Server.jl"]
