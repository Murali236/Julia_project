FROM julia:1.11-bookworm AS julia
FROM node:22-bookworm-slim AS frontend
WORKDIR /app
COPY package.json package-lock.json ./
COPY frontend/package.json frontend/package.json
RUN npm ci
COPY frontend frontend
RUN npm run build

FROM node:22-bookworm-slim
COPY --from=julia /usr/local/julia /usr/local/julia
ENV PATH="/usr/local/julia/bin:${PATH}" HOST=0.0.0.0 PORT=8080 CHROMIUM_NO_SANDBOX=1
# Build and runtime must use the same portable CPU target and depot, including
# when Render starts the image on a different host from the image builder.
ENV JULIA_CPU_TARGET=generic JULIA_DEPOT_PATH=/opt/julia-depot \
    JULIA_NUM_THREADS=1 JULIA_NUM_PRECOMPILE_TASKS=1 OPENBLAS_NUM_THREADS=1 \
    MAX_CONCURRENT_JOBS=1
WORKDIR /app
COPY package.json package-lock.json ./
COPY frontend/package.json frontend/package.json
RUN npm ci --omit=optional && npx playwright install --with-deps chromium
# Resolve stdlib metadata for the container's Julia version; the local Manifest
# was generated by Julia 1.13 and is not portable back to every 1.11 runtime.
COPY backend/Project.toml backend/
RUN julia --startup-file=no --project=backend -e 'using Pkg; Pkg.instantiate(); Pkg.precompile(); using HTTP, JSON3'
COPY backend/src backend/src
COPY reports reports
COPY --from=frontend /app/frontend/dist frontend/dist
EXPOSE 8080
# Minimize runtime JIT memory on small web instances. Solver children inherit
# this compilation mode through Base.julia_cmd().
CMD ["julia", "--compile=min", "--heap-size-hint=128M", "--startup-file=no", "--project=backend", "backend/src/Server.jl"]
